# Copy to .env and fill in for local development.
DATABASE_URL="postgresql://netsifr:netsifr_dev_password@localhost:5432/netsifr_dev"
DATABASE_URL_TEST="postgresql://netsifr:netsifr_dev_password@localhost:5432/netsifr_test"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

RESEND_API_KEY=""
EMAIL_FROM="NetSifr <no-reply@netsifr.org>"

# Optional — overrides the seed script's default first-admin email.
BOOTSTRAP_ADMIN_EMAIL="admin@netsifr.org"

NODE_ENV="development"
